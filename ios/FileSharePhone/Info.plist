<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>文件共享中心</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.fileshare.phone</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- WKWebView 需要加载 http://127.0.0.1:5000/ 明文 HTTP，以及局域网 http:// 主机 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- iOS 14+ 访问局域网必须声明用途，首次使用时系统会弹窗询问 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>本 App 需要在同一 WiFi 局域网内提供文件共享与群聊服务，以便其他设备访问本机共享的文件。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>

	<!-- 说明：声明后台 fetch 仅为让系统在进入后台时给予一点额外执行时间，
	     并配合 AppDelegate 的 beginBackgroundTask 给正在进行的传输收尾。
	     iOS 不允许普通 App 在后台常驻监听 socket，切后台后服务很快不可用，
	     必须保持 App 在前台才能当主机。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>

	<!-- 允许通过「文件」App / Finder 访问 Documents/SharedFiles 与 Downloads -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
